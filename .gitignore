# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 私钥（绝不提交）────────────────────────────────────
*.pem
*.key

# ── 运行期数据：账本与密钥 ──────────────────────────────
# mcp/data/<agent>/ 是 server.py 跑起来才会生成的东西（ledger.json + issuer.pem）。
# 它不是源码，而且**含私钥**——所以整个目录排除。
# 需要时跑 `python CIRCE/mcp/server.py --selftest` 会重建。
mcp/data/

# ── Anthropic 数据导出（个人数据）──────────────────────
mcp/claude-导出/

# ── 本地私密副本：含**未脱敏**的原文 ────────────────────
# 公开发布的那份已脱敏；原文留在这里，只在本机。
.private/

# ── 录制代理的临时捕获 ─────────────────────────────────
mcp/_capture*.log

# ── 论文构建产物（由 tools/md_to_pdf.py 重新生成）──────
# 仓库里只放 Markdown 源，PDF 不入库。
paper/*.pdf
